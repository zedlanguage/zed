decimal-literal-at-int
  rejected: [
    Diagnostic {
        line: 4,
        col: 11,
        message: "A decimal literal is never an `int`: `x : int * 2.0`. Try `bad = x * 2` instead.",
        steps: [
            Step {
                line: 4,
                col: 7,
                text: "`x` is 3 here",
                source: "bad = x * 2.0;             // ✗ Numeric literal at a carrier that cannot take it: x is an int, and a decimal literal is never an int; write x * 2 or f64(x) * 2.0",
                width: 1,
            },
            Step {
                line: 3,
                col: 7,
                text: "`x` is defined as this expression, 3",
                source: "x   = 3;",
                width: 1,
            },
            Step {
                line: 3,
                col: 7,
                text: "this expression is 3",
                source: "x   = 3;",
                width: 1,
            },
            Step {
                line: 4,
                col: 11,
                text: "this literal, 2.0, is 2.0",
                source: "bad = x * 2.0;             // ✗ Numeric literal at a carrier that cannot take it: x is an int, and a decimal literal is never an int; write x * 2 or f64(x) * 2.0",
                width: 3,
            },
            Step {
                line: 4,
                col: 7,
                text: "`*` takes (int, int) -> int",
                source: "bad = x * 2.0;             // ✗ Numeric literal at a carrier that cannot take it: x is an int, and a decimal literal is never an int; write x * 2 or f64(x) * 2.0",
                width: 7,
            },
            Step {
                line: 4,
                col: 7,
                text: "`*` takes (f64, f64) -> f64",
                source: "bad = x * 2.0;             // ✗ Numeric literal at a carrier that cannot take it: x is an int, and a decimal literal is never an int; write x * 2 or f64(x) * 2.0",
                width: 7,
            },
            Step {
                line: 4,
                col: 7,
                text: "`*` takes (rat, rat) -> rat",
                source: "bad = x * 2.0;             // ✗ Numeric literal at a carrier that cannot take it: x is an int, and a decimal literal is never an int; write x * 2 or f64(x) * 2.0",
                width: 7,
            },
            Step {
                line: 4,
                col: 7,
                text: "repair: write `rat(x)`; the checker accepts that",
                source: "bad = x * 2.0;             // ✗ Numeric literal at a carrier that cannot take it: x is an int, and a decimal literal is never an int; write x * 2 or f64(x) * 2.0",
                width: 1,
            },
            Step {
                line: 4,
                col: 7,
                text: "repair: write `f64(x)`; the checker accepts that",
                source: "bad = x * 2.0;             // ✗ Numeric literal at a carrier that cannot take it: x is an int, and a decimal literal is never an int; write x * 2 or f64(x) * 2.0",
                width: 1,
            },
        ],
        menu: "\n  fixes, each checked here:\n    bad = x * 2;           2 takes the int of x\n    bad = rat(x) * 2.0;    x is cast to rat, and `*` takes two rat\n    bad = f64(x) * 2.0;    x is cast to f64, exactly, since it lies within ±2^53",
        row: Some(
            LiteralCarrier,
        ),
    },
]
  checks: [Outcome { line: 4, col: 11, failure: None }]

