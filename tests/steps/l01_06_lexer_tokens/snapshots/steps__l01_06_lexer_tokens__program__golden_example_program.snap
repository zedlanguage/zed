  2 | parse : ( String ) -> Config | #syntaxError ( pos : int )
  3 | conf = parse ( text ) «else» defaultConfig ;
  4 | port = parse ( text ) ?. server ?. port «else» 8080₍10₎ ;
  5 | msg = «match» parse ( text ) { #syntaxError ( pos : ) -> str["bad at " ${pos}] , c -> c . name } ;
  6 | results = files . map ( f -> read ( f ) ) . map ( b -> parse ( b ) ) ;
  7 | good = results . where ( r -> r «is» Config ) ;
  8 | bad = results . where ( r -> r «is» «not» Config ) ;
  9 | amounts = files . map ( f -> int ( read ( f ) ) ) ;
 10 | sumKept = amounts . where ( a -> a «is» int ) >< ( + ) ;
 11 | sumZeroed = amounts . map ( a -> a «else» 0₍10₎ ) >< ( + ) ;
