// Normalizes the username on the first line to lower case, and notes on standard error
// whether it had to change.
normal(positional name) = lower(trim(name))
test { "Ada" -> "ada", " bo " -> "bo", "eve" -> "eve" }

main(m: MainArgs) {
  line = m.stdin[0] else #ioError -> "" else #outOfBounds -> "";
  name = normal(line);
  m.stdout <- name;
  m.stderr <- if name == line { "unchanged" } else { "normalized \"${line}\"" };
}
test {
  "eve\n" -> { stdout: "eve\n", stderr: "unchanged\n" },
  "Ada\n" -> { stdout: "ada\n", stderr: "normalized \"Ada\"\n" },
}
