// Reads the mode from a config file, trimmed, and falls back to quiet when the file is
// missing; an unreadable file is reported rather than defaulted.
main(fs: Files) -> (stdout: Lines) {
  mode = trim(fs["app.conf"]) else #notFound -> "quiet";
  stdout <- "mode=${mode}" else #ioError -> "app.conf is unreadable";
}
test {
  (path -> if path == "app.conf" { "  verbose  \n" } else { #notFound }) -> "mode=verbose\n",
  (path -> #notFound) -> "mode=quiet\n",
  (path -> #ioError) -> "app.conf is unreadable\n",
}
