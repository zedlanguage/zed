// Reads the mode from a config file, trimmed, and falls back to quiet when the file is
// missing; an unreadable file is reported rather than defaulted.
main(m: MainArgs) {
  fs = files();
  mode = trim(fs["app.conf"]) else #notFound -> "quiet";
  m.stdout <- "mode=${mode}" else #ioError -> "app.conf is unreadable";
}
test {
  ("", "", (n -> #notFound), (path -> if path == "app.conf" { "  verbose  \n" } else { #notFound }))
    -> "mode=verbose\n",
  ("", "", (n -> #notFound), (path -> #notFound)) -> "mode=quiet\n",
  ("", "", (n -> #notFound), (path -> #ioError)) -> "app.conf is unreadable\n",
}
