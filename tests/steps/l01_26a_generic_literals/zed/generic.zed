// A step counter for int, f64 and rat alike: `1n` is one in the carrier of `x`.
inc(positional x) = x + 1n
test { 2 -> 3, 2.5 -> 3.5, 1r / 10r -> 11r / 10r }

// Halfway to a target, at f64 or rat: `/` takes no int.
midpoint(positional a, positional b) = (a + b) / 2n
test { (1.0, 2.0) -> 1.5, (1r, 2r) -> 3r / 2r }

// 2^53 + 1 is not an f64, so the offset takes int and rat only.
offset(positional x) = x + 9007199254740993n
test { 0 -> 9007199254740993, 0r -> 9007199254740993r }

// With nothing to follow, a generic literal is an int.
mask = 0xFFn + 1n;
