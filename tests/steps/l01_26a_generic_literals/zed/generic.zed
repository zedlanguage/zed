// A step counter for int, f64 and rat alike: `1` is one in the carrier of `x`.
inc(positional x) = x + 1
test { 2 -> 3, 2.5f64 -> 3.5, 1r / 10r -> 11r / 10r }

// Halfway to a target, at f64 or rat: `/` takes no int.
midpoint(positional a, positional b) = (a + b) / 2
test { (1.0f64, 2.0f64) -> 1.5, (1r, 2r) -> 3r / 2r }

// 2^53 + 1 is not an f64, so the offset takes int and rat only.
offset(positional x) = x + 9007199254740993
test { 0 -> 9007199254740993, 0r -> 9007199254740993r }

// With nothing to follow, a generic literal is an int.
mask = 0xFF + 1;
