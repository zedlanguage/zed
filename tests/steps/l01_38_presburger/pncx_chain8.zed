q(x: int) = !(x mod 3 == 2 && x > 11) && (x mod 4 == 1 || x > (0 - 5)) && x > 0 && x < 75;
p0(x: int) = x > (0 - 4);
p1(x: int) = q(x: x) && p0(x: x + (0 - 2)) && x < 327;
p2(x: int) = q(x: x) && p1(x: x + (0 - 2)) && x < 114;
p3(x: int) = q(x: x) && p2(x: x + (0 - 1)) && x < 159 && (x > 7 || x mod 5 == 2);
p4(x: int) = q(x: x) && p3(x: x + 6) && x < 274;
p5(x: int) = q(x: x) && p4(x: x + 6) && x < 188;
p6(x: int) = q(x: x) && p5(x: x + (0 - 5)) && x < 328 && (x mod 5 == 2 || x mod 2 == 2);
p7(x: int) = q(x: x) && p6(x: x + 1) && x < 150;
p8(x: int) = q(x: x) && p7(x: x + (0 - 2)) && x < 109 && (x mod 3 != 1 || x < 14);
p9(x: int) = q(x: x) && p8(x: x + (0 - 4)) && x < 140;
