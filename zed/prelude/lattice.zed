// prelude unit lattice (DESIGN.md sec:checking_in_zed, written by step M0.5)
// The store's lattices, their widenings and their narrowings. The Rust-hosted checker's copy is
// crates/zedc/src/store/{interval,lattice}.rs; until this unit first runs (its
// last layer is L6), the tests of tests/steps/m0_05_widening_and_iteration/
// check that copy.
//
// The struct signatures of Lattice and Facet are drafts: their field types are
// written as the type language of L1.24 and L12 will spell them.

struct Lattice {
  bottom: Any,
  top: Any,
  leq: Any,      // (a, b) -> bool
  join: Any,     // (a, b) -> element
  meet: Any,     // (a, b) -> element
  widen: Any,    // (old, new, marks) -> element, for new above old; every chain finite
  narrow: Any,   // (old, new, marks) -> element, for new below old; every chain finite
}

// The landmarks: the program's integer literals k, each as k - 1, k and k + 1,
// and its other literal values. A widening moves a bound only to an old bound,
// a landmark or infinity, and a finite set keeps only landmarks it did not hold,
// so every chain is finite with no delay and no cap (docs/thresholds.md,
// replacement 3).
struct Landmarks { ints: [int], values: [Any] }

landmarks(positional ints, positional values) =
  Landmarks(ints: ints.flatMap(k -> [k - 1, k, k + 1]).distinct, values: values.distinct);

marked(positional marks, positional v) = marks.ints.contains(v) || marks.values.contains(v);

struct Facet {
  kind: #semantic | #evidence | #hint,
  lattice: Lattice,
  holds: Any,    // (fact, value) -> bool, for an evidence facet only
  transfer: Any, // (op, a, b) -> fact
}

// The flat lattice over the given elements: #empty below each of them, top
// above each of them, and the elements themselves unordered.
flat(positional elems, top) = Lattice(
  bottom: #empty,
  top: top,
  leq: (a, b) -> a == #empty || a == b || b == top,
  join: (a, b) -> if a == #empty { b } else if b == #empty || a == b { a } else { top },
  meet: (a, b) -> if a == top { b } else if b == top || a == b { a } else { #empty },
  widen: (a, b, marks) -> if a == #empty { b } else if b == #empty || a == b { a } else { top },
  narrow: (a, b, marks) -> b,
);

// ---- Interval unions --------------------------------------------------------
// An element is a list of pieces [lo, hi], sorted, disjoint, and with at least
// one integer missing between neighbors. An end is an int, #ninf or #pinf.

endLe(positional a, positional b) = match a {
  #ninf -> true,
  #pinf -> b == #pinf,
  _ -> match b { #ninf -> false, #pinf -> true, _ -> a <= b },
};

endMin(positional a, positional b) = if endLe(a, b) { a } else { b };
endMax(positional a, positional b) = if endLe(a, b) { b } else { a };

// The size of the gap between two neighboring pieces: the integers between them.
gap(positional p, positional q) = q[0] - p[1] - 1;

// Merges the two neighbors with the smallest gap, the lower pair on a tie, until
// at most `limit` pieces remain. Not a join, and not monotone.
cap(positional xs, positional limit) =
  if xs::len <= limit { xs }
  else {
    i = smallestGap(xs, 0, 1);
    cap(xs.take(i) ++ [[xs[i][0], xs[i + 1][1]]] ++ xs.drop(i + 2), limit)
  };

smallestGap(positional xs, positional best, positional i) =
  if i + 1 >= xs::len { best }
  else if gap(xs[i], xs[i + 1]) < gap(xs[best], xs[best + 1]) { smallestGap(xs, i, i + 1) }
  else { smallestGap(xs, best, i + 1) };

// The finite endpoints of old and the integer landmarks: where a moved end stops.
targets(positional old, positional marks) =
  old.flatMap(p -> [p[0], p[1]]).filter(e -> e != #ninf && e != #pinf) ++ marks.ints;

// The greatest target at or below v, else none; the least at or above v, else none.
floorIn(positional ts, positional v, positional none) =
  ts.filter(t -> t <= v).fold(none, (a, t) -> if a == none || t > a { t } else { a });
ceilIn(positional ts, positional v, positional none) =
  ts.filter(t -> t >= v).fold(none, (a, t) -> if a == none || t < a { t } else { a });

// Sorted pieces whose ends moved outward: neighbors that now meet or touch merge.
touches(positional p, positional q) = p[1] == #pinf || q[0] == #ninf || q[0] <= p[1] + 1;
mergeTouching(positional xs) = xs.fold([], (out, p) ->
  if out::len > 0 && touches(out.last else p, p) {
    out.take(out::len - 1) ++ [[(out.last else p)[0], endMax((out.last else p)[1], p[1])]]
  } else { out ++ [p] });

// Moves each finite end of xs outward to the nearest target: a lower end down,
// an upper end up. With no target on that side, an end goes to infinity when
// widening and stays where it is when narrowing.
moveEnds(positional xs, positional ts, positional widen) = mergeTouching(xs.map(p -> [
  if p[0] == #ninf { p[0] } else { floorIn(ts, p[0], if widen { #ninf } else { p[0] }) },
  if p[1] == #pinf { p[1] } else { ceilIn(ts, p[1], if widen { #pinf } else { p[1] }) },
]));

// old ∇ new, for new the join, which contains old. Every finite end of a chain
// lies in K, the first element's ends and the landmarks, so a chain has at most
// 2|K| + 2 elements, at any number of pieces. The bottom widens to new.
intervalWiden(positional old, positional new, positional marks) =
  if old::len == 0 || new == old { new } else { moveEnds(new, targets(old, marks), true) };

// old Δ new, for new the meet, which old contains. An end of new moves back to
// an end of old or a landmark; an infinite end of old takes a finite bound once,
// so each side changes at most once from infinite and then only to points of a
// finite set.
intervalNarrow(positional old, positional new, positional marks) =
  moveEnds(new, targets(old, marks), false);

// ---- Congruences ------------------------------------------------------------
// #class(modulus:, residue:), with modulus 0 for one value and 1 for every
// integer, or #bottom. Ascending chains are finite (each modulus divides the
// one before), so the widening is the join. Descending chains are not (0 mod 2,
// 0 mod 4, ...), so the narrowing takes new only from the top, or when new is
// one value or none: it changes at most three times.

gcd(positional a, positional b) = if b == 0 { a } else { gcd(b, a mod b) };

congruence(positional m, positional r) =
  #class(modulus: m, residue: if m == 0 { r } else { r mod m });

congruenceJoin(positional a, positional b) = match a {
  #bottom -> b,
  #class(modulus: m, residue: r) -> match b {
    #bottom -> a,
    #class(modulus: n, residue: s) -> congruence(gcd(gcd(m, n), abs(r - s)), r),
  },
};

member(positional c, positional v) = match c {
  #bottom -> false,
  #class(modulus: m, residue: r) -> if m == 0 { v == r } else { v mod m == r },
};

// The inverse of a modulo n, for a and n coprime: the extended Euclidean
// algorithm, keeping only the coefficient of a.
inverse(positional a, positional n) = inverseStep(a mod n, n, 1, 0, n);
inverseStep(positional r0, positional r1, positional t0, positional t1, positional n) =
  if r1 == 0 { t0 mod n }
  else { q = r0 div r1; inverseStep(r1, r0 - q * r1, t1, t0 - q * t1, n) };

// The Chinese remainder theorem: r mod m and s mod n meet iff r == s mod
// g = gcd(m, n), in one class modulo lcm(m, n). A class whose modulus would
// leave the integer range is not formed; the operand with the larger modulus is
// kept, which is a sound bound.
congruenceMeet(positional a, positional b) = match a {
  #bottom -> #bottom,
  #class(modulus: m, residue: r) -> match b {
    #bottom -> #bottom,
    #class(modulus: n, residue: s) ->
      if m == 0 { if member(b, r) { a } else { #bottom } }
      else if n == 0 { if member(a, s) { b } else { #bottom } }
      else if (s - r) mod gcd(m, n) != 0 { #bottom }
      else {
        g = gcd(m, n);
        l = m div g * n else #overflow;
        k = (s - r) div g mod (n div g) * inverse(m div g, n div g) mod (n div g);
        if l == #overflow { if m >= n { a } else { b } } else { congruence(l, r + m * k) }
      },
  },
};

congruenceLattice = Lattice(
  bottom: #bottom,
  top: congruence(1, 0),
  leq: (a, b) -> congruenceJoin(a, b) == b,
  join: congruenceJoin,
  meet: congruenceMeet,
  widen: (a, b, marks) -> congruenceJoin(a, b),
  narrow: (a, b, marks) -> congruenceNarrow(a, b),
);

congruenceNarrow(positional old, positional new) =
  if old == congruence(1, 0) { new }
  else { match new { #bottom -> new, #class(modulus: m, residue: r) -> if m == 0 { new } else { old } } };

// ---- Finite sets and cardinalities ------------------------------------------

// The join when every member it adds is a landmark, else #top: the members of
// a chain are the first element's and landmarks. The bottom widens to new.
finiteSetWiden(positional old, positional new, positional marks) =
  if old == [] { new }
  else if old == #top || new == #top { #top }
  else {
    j = (old ++ new).distinct;
    if j.filter(v -> !old.contains(v) && !marked(marks, v))::len == 0 { j } else { #top }
  };

// A descending chain leaves #top at most once and then loses members.
finiteSetNarrow(positional old, positional new, positional marks) = new;

// A cardinality is one interval of [0, #pinf]: the interval widening or
// narrowing, with a lower end at #ninf read as 0.
cardWiden(positional old, positional new, positional marks) =
  intervalWiden(old, new, marks).map(p -> [endMax(p[0], 0), p[1]]);
cardNarrow(positional old, positional new, positional marks) =
  intervalNarrow(old, new, marks).map(p -> [endMax(p[0], 0), p[1]]);
