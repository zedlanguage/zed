// variant: // u = twice(d);                        // ✗ Rounded value at a parameter that refuses it: d is rounded at 0.1f64 and at +
a = f64(1r/3r);                         // 0.3333333333333333 with inexact()
b = f64(9007199254740993);              // 9007199254740992.0 with inexact()
c = 0.5f64 + 0.25f64;                   // 0.75, no fact: both are binary fractions and the sum is exact
d = 0.1f64 + 0.2f64;                    // 0.30000000000000004 with inexact()
e = rat(d);                             // 1351079888211149r/4503599627370496r with inexact()
n = round(7r/2r);                       // 4, no fact: 7r/2r is exact
m = round(d * 10.0);                    // 3 with inexact()
same = c == 0.75;                       // true, no warning
near = abs(d - 0.3) <= 1e-9;            // true, no warning
// eq = d == 0.3;                       // warning: Exact comparison of a rounded value: d carries inexact()
// k = int(7r/2r);                      // ✗ No `int` equals the value: 7r/2r is not whole
twice(x: f64 with inexact(false)) = x * 2.0;
t = twice(c);                           // 1.5
u = twice(d);                        // ✗ Rounded value at a parameter that refuses it: d is rounded at 0.1f64 and at +
