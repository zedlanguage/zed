// layer L1
// Output fixed by DESIGN.md (at 843be85) line 322: floats print the shortest digit string that
// reads back, in fixed notation with a digit on each side of the point when the exponent is in
// -6..<21, otherwise "one digit, a point, the remaining digits (`0` when there are none), and
// `e` followed by the exponent, with `-` only when it is negative"; zeros print `0.0`, `-0.0`;
// `1.0 / 0.0` is `inf`.
// Each decimal literal that nothing else gives a carrier is written with `f64` (L1.26b).
main(m: MainArgs) {
  x = f64(trim(m.stdin[1] else "")) else 0.0;
  m.stdout <- "${x + 0.2} ${1.0f64 / 3.0} ${1e21f64} ${1e20f64} ${1.5e-7f64} ${0.000001f64} ${-0.0f64} ${1.0f64 / 0.0} ${2.5f64 * 2.0}";
}
