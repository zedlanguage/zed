// layer L1
// Output fixed by DESIGN.md (at 843be85) line 640: `div`/`mod` are Euclidean, "0 ≤ a mod b < |b|";
// line 2961: `^` binds tighter than unary minus; line 331: "semantic `int` widens its
// domain instead of overflowing".
main(m: MainArgs) {
  n = int(trim(m.stdin[1] else "")) else 0;
  m.stdout <- "${(0 - 7) div 2} ${(0 - 7) mod 2} ${7 div (0 - 2)} ${7 mod (0 - 2)} ${n mod 3} ${-2^2} ${2^100}";
}
