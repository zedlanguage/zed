// layer L1
// Output fixed by DESIGN.md (at 843be85) line 1819: a `Lines` input is keyed by line number from
// 1, so a missing line is `#notFound`; line 1817: `int(s)` reads an optional `-` and decimal
// digits, anything else `#invalid`; line 504: `x div 0` is `#divByZero`; `else` replaces each.
main(stdin: Lines) -> (stdout: Lines) {
  a = int(trim(stdin[1] else "")) else -1;
  b = int(trim(stdin[2] else "")) else -2;
  c = int(trim(stdin[9] else "none")) else -3;
  stdout <- "${a} ${b} ${c} ${(a div b) else 0} ${(7 div (a - 12)) else 99}";
}
