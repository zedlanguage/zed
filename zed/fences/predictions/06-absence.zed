// layer L1
// Output fixed by DESIGN.md step L1.19: a `Lines` input is keyed from 0, so a missing line is
// `#outOfBounds`; DESIGN.md (at 843be85) line 1817: `int(s)` reads an optional `-` and decimal
// digits, anything else `#invalid`; line 504: `x div 0` is `#divByZero`; `else` replaces each.
main(m: MainArgs) {
  a = int(trim(m.stdin[0] else #ioError -> "" else #outOfBounds -> "")) else #invalid -> -1;
  b = int(trim(m.stdin[1] else #ioError -> "" else #outOfBounds -> "")) else #invalid -> -2;
  c = int(trim(m.stdin[8] else #ioError -> "none" else #outOfBounds -> "none")) else #invalid -> -3;
  m.stdout <- "${a} ${b} ${c} ${(a div b) else #divByZero -> 0} ${(7 div (a - 12)) else #divByZero -> 99}";
}
