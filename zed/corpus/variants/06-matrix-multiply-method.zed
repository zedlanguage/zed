// layer L14
// 06, the standard-library method `matmul` (sec:linalg). Input and output:
// those of 06-matrix-multiply, on every input with a row of B (see
// 06-matrix-multiply-remap.zed, whose remap `matmul` is). `matmul` needs A's
// columns and B's rows to have one domain, so A and B are built as in that file.
main(m: MainArgs) {
  rows  = m.stdin.map(l -> l.split(" ").map(t -> f64(t) else 0.0));
  hdr   = (m.stdin[0] else "").split(" ").map(t -> int(t) else 0);
  n     = hdr[0] else 0;
  inner = hdr[1] else 0;
  p     = hdr[2] else 0;
  aRows = rows.slice(1..<1 + n);
  bRows = rows.slice(1 + n..<1 + n + inner);
  a     = aRows.map(row -> for c -> _ in bRows { row[c - 1 - n] else 0.0 });
  b     = bRows.map(r -> for k in 0..<p { r[k] else 0.0 });
  m.stdout <- a.matmul(b).map(r -> r.map(v -> "${v}").concat(" "));
}
