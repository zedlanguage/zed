// layer L13
// 20, the error version: must be rejected at compile time (taint(#user)
// flows through the interpolation into the taint(#clean) port). Expected
// diagnostic: the sink demands taint(#clean), the value carries taint(#user),
// and the menu offers sanitize.
main(stdin: Lines with taint(#user)) -> (stdout: Lines with taint(#clean)) {
  stdout <- stdin.map(l -> "<li>${l}</li>");
}
