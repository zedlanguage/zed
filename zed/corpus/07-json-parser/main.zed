// layer L20
// 07 JSON parser: one struct-grammar declaration gives the parser and the
// serializer (sec:tooling). Each input line is one document; the program prints
// its canonical form (serializeText: no insignificant whitespace) or the error
// position of the line's #syntaxError. A bad line does not stop the next one,
// and a round trip that loses or reorders anything shows in the output.
// Units: 07-json-parser/zed.manifest marks the package root, so this file is
// the unit `main` and `import json.{Json};` resolves to json.zed beside it.
import json.{Json};

main(m: MainArgs) {
  m.stdout <- m.stdin.map(l -> match Json.parseText(l) {
    #syntaxError(pos:) -> "error at ${pos}",
    doc -> doc.serializeText,
  });
}
