+++ b/tests/steps/l01_36_cranelift/scaling.rs
@@ -0,0 +1,42 @@
+use zed_kernel::Term;
+use zed_kernel::term::build::{let_, lit, var};
+
+/// `if i < d then (let y{i} = (if ...) + 1 in y{i}) else i`, `d` deep.
+pub(crate) fn nest(d: usize) -> Term {
+    use zed_kernel::Prim;
+    use zed_kernel::term::build::{if_, prim};
+    let mut t = lit(0);
+    for i in 0..d {
+        let y = format!("y{i}");
+        let inner = let_(&y, prim(Prim::Add, vec![t, lit(1)]), var(&y));
+        t = if_(
+            prim(Prim::Lt, vec![lit(i as i64), lit(d as i64)]),
+            inner,
+            lit(i as i64),
+        );
+    }
+    t
+}
+
+#[test]
+fn probe_z9() {
+    std::thread::Builder::new()
+        .stack_size(1 << 30)
+        .spawn(|| {
+            for d in [100, 200, 400, 800] {
+                let t = nest(d);
+                let s = std::time::Instant::now();
+                let g = zedc::zir::lower::lower(&t).unwrap();
+                let a = s.elapsed();
+                let s = std::time::Instant::now();
+                let p = zedc::zir::memory::plan(&g, true);
+                let b = s.elapsed();
+                let s = std::time::Instant::now();
+                zed_native::object(&g, &p).unwrap();
+                eprintln!("PROBE z9 d={d} lower {a:?} plan {b:?} object {:?}", s.elapsed());
+            }
+        })
+        .unwrap()
+        .join()
+        .unwrap();
+}
